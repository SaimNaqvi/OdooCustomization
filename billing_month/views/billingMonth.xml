<odoo>
    <data>
        <record model="ir.ui.view" id="account_move_inherited_form_view">
            <field name="name">Account Move Inherited Form View</field>
            <field name="model">account.move</field>
            <!-- Paste the ref="external_id of the model in which you want it to run" -->
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="arch" type="xml">  
                <xpath expr="//field[@name='invoice_date']" position="after">
                    <!-- Add new fields here -->
                    <!-- <field name="due_date_I"/> -->
                    <field name="billingMonth" string= "Billing Month"/>
                </xpath>
                        
            </field>
        </record>
    </data>
</odoo>
