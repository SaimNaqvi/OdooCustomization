<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Adding billing month field in form view of Subscriptions -->
    <record id="view_sale_subscription_billing_month_form" model="ir.ui.view">
        <field name="name">sale.subscription.form.view</field>
        <field name="model">sale.subscription</field>
        <field name="inherit_id" ref="sale_subscription.sale_subscription_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='date_start']" position="after">
                <field string="Billing Month" name="billing_month" attrs="{'invisible': [('stage_category', '!=', 'progress')]}"/>
            </xpath>
        </field>
    </record>

    <!-- Adding billing month field in tree view of Subscriptions -->
    <record id="view_sale_subscription_billing_month_tree" model="ir.ui.view">
        <field name="name">sale.subscription.list</field>
        <field name="model">sale.subscription</field>
        <field name="inherit_id" ref="sale_subscription.sale_subscription_view_list"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='recurring_next_date']" position="before">
                <field string="Billing Month" name="billing_month" attrs="{'invisible': [('stage_category', '!=', 'progress')]}"/>
            </xpath>
        </field>
    </record>

    <!-- Wizard View to update the next invoice date of records selected in subscription -->
    <record id="view_update_recurring_next_date_wizard_form" model="ir.ui.view">
        <field name="name">update.recurring.next.date.wizard.form</field>
        <field name="model">update.recurring.next.date.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="recurring_invoice_date"/>
                </group>
                <footer>
                    <button string="Update" type="object" name="update_records" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>

