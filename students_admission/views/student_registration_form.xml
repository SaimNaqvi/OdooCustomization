<odoo>
    <template id="student_registration_form" name="Student Registration Form">
        <t t-call="website.layout">
            <xpath expr="//head" position="inside">
                <!-- TailwindCSS CDN -->
                <link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css" rel="stylesheet"/>
                <!-- Flatpickr for date picker -->
                <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css"/>
                <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
                <!-- jQuery -->
                <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
                <!-- Inputmask Plugin -->
                <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery.inputmask/5.0.9/jquery.inputmask.min.js"></script>
                <style>
                    <!-- Style for the tabbed sections -->
                    .tab-content {
                    display: none;
                    }
                    .tab-content.active {
                    display: block;
                    }
                </style>
            </xpath>
            <section class="s_title parallax s_parallax_is_fixed bg-black-50 pt24 pb24" data-vcss="001"
                     data-snippet="s_title" data-scroll-background-ratio="1" data-name="Title">
                <span class="s_parallax_bg oe_img_bg"
                      style="background-image: url('/web/image/website.s_banner_default_image'); background-position: 50% 0;"/>
                <div class="o_we_bg_filter bg-black-50"/>
                <div class="container">
                    <h1>Student Registration</h1>
                </div>
            </section>
            <div class="w-full bg-gray-100 p-4 sm:p-8">
                <div class="w-full sm:w-4/5 mx-auto flex flex-col sm:flex-row space-y-4 sm:space-y-0 sm:space-x-8">

                    <div class="sm:w-1/4 bg-white rounded-lg shadow-lg p-4">
                        <!-- Start Tabs -->
                        <div class="flex justify-center sm:flex-col sm:space-y-1">
                            <button class="tab-button bg-gray-50 text-gray-600 sm:text-left font-medium py-2 px-4 border border-gray-300 rounded-l-md sm:rounded-md focus:outline-none hover:bg-blue-500 hover:text-white"
                                    data-target="stu-reg-form">Student Registration Form
                            </button>
                            <button class="tab-button bg-gray-50 text-gray-600 sm:text-left font-medium py-2 px-4 border border-gray-300 rounded-r-md sm:rounded-md focus:outline-none hover:bg-blue-500 hover:text-white"
                                    data-target="stu-test-form">Student Test Form
                            </button>
                        </div>
                        <!-- End Tabs -->
                    </div>

                    <div class="w-full sm:w-3/4 bg-white rounded-lg shadow-lg p-4 sm:p-8">
                        <!-- Start Tab Contents -->
                        <div id="stu-reg-form" class="tab-content active">
                            <form id="stu_reg_form" name="stu_reg_form" method="post"
                                  action="/student/registration/submit">
                                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                <h2 class="text-3xl font-bold mb-6 text-center text-gray-800">Student Registration
                                    Form
                                </h2>
                                <!-- Start Parent/Guardian Information -->
                                <h3 class="text-xl font-semibold text-gray-700 mb-4">Parent/Guardian Information</h3>
                                <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-4">
                                    <div>
                                        <label for="par_cnic_search" class="block text-gray-600 font-medium">CNIC No.
                                            <span class="text-red-500">(Search existing parent)</span>
                                        </label>
                                        <input type="text" id="par_cnic_search" name="par_cnic_search"
                                               class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-blue-500 focus:border-blue-500 sm:text-sm"
                                               placeholder="99999-9999999-9"/>
                                    </div>
                                    <div class="flex items-end">
                                        <button type="button" id="par_cnic_search_btn" name="par_cnic_search_btn"
                                                class="bg-blue-500 hover:bg-blue-600 text-white font-bold py-2 px-4 rounded focus:outline-none focus:shadow-outline transition duration-300">
                                            Search
                                        </button>
                                    </div>
                                </div>
                                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-4">
                                    <div>
                                        <label for="par_firstname" class="block text-gray-600 font-medium">First Name
                                            <span class="text-red-500">*</span>
                                        </label>
                                        <input type="text" id="par_firstname" name="par_firstname"
                                               class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-blue-500 focus:border-blue-500 sm:text-sm"
                                               placeholder="Enter First Name" required="required"/>
                                    </div>
                                    <div>
                                        <label for="par_lastname" class="block text-gray-600 font-medium">Last Name
                                            <span class="text-red-500">*</span>
                                        </label>
                                        <input type="text" id="par_lastname" name="par_lastname"
                                               class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-blue-500 focus:border-blue-500 sm:text-sm"
                                               placeholder="Enter Last Name" required="required"/>
                                    </div>
                                </div>
                                <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-4">
                                    <div>
                                        <label for="par_gender" class="block text-gray-600 font-medium">Gender
                                            <span class="text-red-500">*</span>
                                        </label>
                                        <select id="par_gender" name="par_gender"
                                                class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-blue-500 focus:border-blue-500 sm:text-sm"
                                                required="required">
                                            <option value="" selected="selected" disabled="disabled">Select Gender
                                            </option>
                                            <option value="male">Male</option>
                                            <option value="female">Female</option>
                                            <option value="other">Other</option>
                                        </select>
                                    </div>
                                    <div>
                                        <label for="par_religion" class="block text-gray-600 font-medium">Religion
                                        </label>
                                        <select id="par_religion" name="par_religion"
                                                class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-blue-500 focus:border-blue-500 sm:text-sm">
                                            <option value="" selected="selected" disabled="disabled">Select Religion
                                            </option>
                                            <option value="Islam">Islam</option>
                                            <option value="Christian">Christianity</option>
                                            <option value="hindu">Hinduism</option>
                                            <option value="sikh">Sikhism</option>
                                        </select>
                                    </div>
                                    <div>
                                        <label for="par_relation_type" class="block text-gray-600 font-medium">
                                            Relationship Type
                                            <span class="text-red-500">*</span>
                                        </label>
                                        <select id="par_relation_type" name="par_relation_type"
                                                class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-blue-500 focus:border-blue-500 sm:text-sm"
                                                required="required">
                                            <option value="" selected="selected" disabled="disabled">Select Relationship
                                                Type
                                            </option>
                                            <option value="father">Father</option>
                                            <option value="mother">Mother</option>
                                            <option value="aunt">Aunt</option>
                                            <option value="brother">Brother</option>
                                            <option value="donor">Donor</option>
                                            <option value="guardian">Guardian</option>
                                            <option value="friend">Friend</option>
                                            <option value="sister">Sister</option>
                                            <option value="spouse">Spouse</option>
                                            <option value="step father">Step Father</option>
                                            <option value="step mother">Step Mother</option>
                                            <option value="uncle">Uncle</option>
                                            <option value="other">Other</option>
                                        </select>
                                    </div>
                                    <div>
                                        <label for="par_cnic" class="block text-gray-600 font-medium">CNIC No.
                                            <span class="text-red-500">*</span>
                                        </label>
                                        <input type="text" id="par_cnic" name="par_cnic"
                                               class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-blue-500 focus:border-blue-500 sm:text-sm"
                                               placeholder="Enter CNIC No." required="required"/>
                                    </div>
                                    <div>
                                        <label for="par_phone" class="block text-gray-600 font-medium">Phone
                                            <span class="text-red-500">*</span>
                                        </label>
                                        <input type="text" id="par_phone"
                                               class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-blue-500 focus:border-blue-500 sm:text-sm"
                                               placeholder="Enter Phone" required="required"/>
                                    </div>
                                    <div>
                                        <label for="par_email" class="block text-gray-600 font-medium">Email</label>
                                        <input type="text" id="par_email" name="par_email"
                                               class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-blue-500 focus:border-blue-500 sm:text-sm"
                                               placeholder="Enter Email"/>
                                    </div>
                                </div>
                                <!-- End Parent/Guardian Information -->

                                <!-- Start Student Information -->
                                <h3 class="text-xl font-semibold text-gray-700 mb-4 mt-8">Student Information</h3>
                                <div class="grid grid-cols-1 gap-4 mb-4">
                                    <div>
                                        <label for="branch_name" class="block text-gray-600 font-medium">Branch Name
                                            <span class="text-red-500">*</span>
                                        </label>
                                        <input type="text" id="branch_name" name="branch_name"
                                               class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-blue-500 focus:border-blue-500 sm:text-sm"
                                               placeholder="Enter Branch Name" t-att-value="branch_name"
                                               required="required" readonly="readonly"/>
                                    </div>
                                </div>
                                <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                                    <div>
                                        <label for="stu_firstname" class="block text-gray-600 font-medium">First Name
                                            <span class="text-red-500">*</span>
                                        </label>
                                        <input type="text" id="stu_firstname" name="stu_firstname"
                                               class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-blue-500 focus:border-blue-500 sm:text-sm"
                                               placeholder="Enter First Name" required="required"/>
                                    </div>
                                    <div>
                                        <label for="stu_lastname" class="block text-gray-600 font-medium">Last Name
                                            <span class="text-red-500">*</span>
                                        </label>
                                        <input type="text" id="stu_lastname" name="stu_lastname"
                                               class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-blue-500 focus:border-blue-500 sm:text-sm"
                                               placeholder="Enter Last Name" required="required"/>
                                    </div>
                                    <div>
                                        <label for="stu_class" class="block text-gray-600 font-medium">Class
                                            <span class="text-red-500">*</span>
                                        </label>
                                        <select id="stu_class" name="stu_class"
                                                class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-blue-500 focus:border-blue-500 sm:text-sm"
                                                required="required">
                                            <option value="" selected="selected" disabled="disabled">Select Class
                                            </option>
                                            <option value="nur">Nur</option>
                                            <option value="prep">Prep</option>
                                            <option value="1">1</option>
                                            <option value="2">2</option>
                                            <option value="3">3</option>
                                            <option value="4">4</option>
                                            <option value="5">5</option>
                                            <option value="6">6</option>
                                            <option value="7">7</option>
                                            <option value="8">8</option>
                                            <option value="9">9</option>
                                            <option value="10">10</option>
                                            <option value="first_year">First Year</option>
                                            <option value="second_year">Second Year</option>
                                        </select>
                                    </div>
                                    <div>
                                        <label for="stu_gender" class="block text-gray-600 font-medium">Gender
                                            <span class="text-red-500">*</span>
                                        </label>
                                        <select id="stu_gender" name="stu_gender"
                                                class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-blue-500 focus:border-blue-500 sm:text-sm"
                                                required="required">
                                            <option value="" selected="selected" disabled="disabled">Select Gender
                                            </option>
                                            <option value="male">Male</option>
                                            <option value="female">Female</option>
                                            <option value="other">Other</option>
                                        </select>
                                    </div>
                                    <div>
                                        <label for="stu_religion" class="block text-gray-600 font-medium">Religion
                                        </label>
                                        <select id="stu_religion" name="stu_religion"
                                                class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-blue-500 focus:border-blue-500 sm:text-sm">
                                            <option value="" selected="selected" disabled="disabled">Select Religion
                                            </option>
                                            <option value="Islam">Islam</option>
                                            <option value="Christian">Christianity</option>
                                            <option value="hindu">Hinduism</option>
                                            <option value="sikh">Sikhism</option>
                                        </select>
                                    </div>
                                    <div>
                                        <label for="stu_dob" class="block text-gray-600 font-medium">Date of Birth
                                            <span class="text-red-500">*</span>
                                        </label>
                                        <input type="text" id="stu_dob" name="stu_dob"
                                               class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-blue-500 focus:border-blue-500 sm:text-sm"
                                               placeholder="DD/MM/YYYY" required="required"/>
                                    </div>
                                    <div>
                                        <button type="submit" id="stu_reg_submit" name="stu_reg_submit"
                                                class="bg-blue-500 hover:bg-blue-600 text-white font-bold py-2 px-4 rounded focus:outline-none focus:shadow-outline transition duration-300">
                                            Submit
                                        </button>
                                    </div>
                                </div>
                                <!-- End Student Information -->
                            </form>
                        </div>

                        <!-- Start Student Test Form -->
                        <div id="stu-test-form" class="tab-content">
                            <form id="stu_test_form" name="stu_test_form" method="post"
                                  action="/student/registration/update" class="oe_website_sale">
                                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                <h2 class="text-3xl font-bold mb-6 text-center text-gray-800">Student Test Form</h2>
                                <div class="grid grid-cols-1 sm:grid-cols-8 gap-4 mb-4">
                                    <div class="col-span-5">
                                        <label for="branch_name" class="block text-gray-600 font-medium">Branch Name
                                            <span class="text-red-500">*</span>
                                        </label>
                                        <input type="text" id="branch_name" name="branch_name"
                                               class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-blue-500 focus:border-blue-500 sm:text-sm"
                                               t-att-value="branch_name" placeholder="Enter Branch Name" required="required" disabled="disabled"/>
                                    </div>
                                    <div class="col-span-2">
                                        <label for="stu_reg_no_search" class="block text-gray-600 font-medium">
                                            Registration No.
                                            <span class="text-red-500">*</span>
                                        </label>
                                        <input type="text" id="stu_reg_no_search" name="stu_reg_no_search"
                                               class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-blue-500 focus:border-blue-500 sm:text-sm"
                                               placeholder="Enter Registration No." required="required"/>
                                    </div>
                                    <div class="flex items-end">
                                        <button type="button" id="stu_reg_no_search_btn_on_reg_form" name="stu_reg_no_search_btn_on_reg_form"
                                                class="w-full bg-blue-500 hover:bg-blue-600 text-white font-bold py-2 px-4 rounded focus:outline-none focus:shadow-outline transition duration-300">
                                            Search
                                        </button>
                                    </div>
                                </div>

                                <!-- Start Student Information -->
                                <h3 class="text-xl font-semibold text-gray-700 mb-4 mt-8">Student Information</h3>
                                <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                                    <div>
                                        <label for="stu_reg_no" class="block text-gray-600 font-medium">Registration No.
                                            <span class="text-red-500">*</span>
                                        </label>
                                        <input type="text" id="stu_reg_no" name="stu_reg_no"
                                               class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-blue-500 focus:border-blue-500 sm:text-sm"
                                               placeholder="Enter Registration No." required="required"
                                               disabled="disabled"/>
                                    </div>
                                    <div>
                                        <label for="reg_stu_firstname" class="block text-gray-600 font-medium">First Name
                                            <span class="text-red-500">*</span>
                                        </label>
                                        <input type="text" id="reg_stu_firstname" name="reg_stu_firstname"
                                               class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-blue-500 focus:border-blue-500 sm:text-sm"
                                               placeholder="Enter First Name" required="required"/>
                                    </div>
                                    <div>
                                        <label for="reg_stu_lastname" class="block text-gray-600 font-medium">Last Name
                                            <span class="text-red-500">*</span>
                                        </label>
                                        <input type="text" id="reg_stu_lastname" name="reg_stu_lastname"
                                               class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-blue-500 focus:border-blue-500 sm:text-sm"
                                               placeholder="Enter Last Name" required="required"/>
                                    </div>
                                    <div>
                                        <label for="reg_stu_class" class="block text-gray-600 font-medium">Class
                                            <span class="text-red-500">*</span>
                                        </label>
                                        <select id="reg_stu_class" name="reg_stu_class"
                                                class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-blue-500 focus:border-blue-500 sm:text-sm"
                                                required="required">
                                            <option value="" selected="selected" disabled="disabled">Select Class
                                            </option>
                                            <option value="nur">Nur</option>
                                            <option value="prep">Prep</option>
                                            <option value="1">1</option>
                                            <option value="2">2</option>
                                            <option value="3">3</option>
                                            <option value="4">4</option>
                                            <option value="5">5</option>
                                            <option value="6">6</option>
                                            <option value="7">7</option>
                                            <option value="8">8</option>
                                            <option value="9">9</option>
                                            <option value="10">10</option>
                                            <option value="first_year">First Year</option>
                                            <option value="second_year">Second Year</option>
                                        </select>
                                    </div>
                                    <div>
                                        <label for="stu_test_date" class="block text-gray-600 font-medium">Test Date
                                        </label>
                                        <input type="date" id="stu_test_date" name="stu_test_date"
                                               class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-blue-500 focus:border-blue-500 sm:text-sm"
                                               placeholder="dd/mm/yyyy"/>
                                    </div>
                                    <div>
                                        <label for="stu_test_status" class="block text-gray-600 font-medium">Test
                                            Status
                                        </label>
                                        <select id="stu_test_status" name="stu_test_status"
                                                class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-blue-500 focus:border-blue-500 sm:text-sm">
                                            <option value="" selected="selected" disabled="disabled">Select Test
                                                Status
                                            </option>
                                            <option value="Pass">Pass</option>
                                            <option value="Fail">Fail</option>
                                            <option value="Dropped">Dropped</option>
                                        </select>
                                    </div>
                                    <div>
                                        <button type="submit" id="stu_test_submit_btn" name="stu_test_submit_btn"
                                                class="bg-blue-500 hover:bg-blue-600 text-white font-bold py-2 px-4 rounded focus:outline-none focus:shadow-outline transition duration-300">
                                            Submit
                                        </button>
                                    </div>
                                </div>
                                <!-- End Student Information -->
                            </form>
                        </div>
                        <!-- End Student Test Form -->
                        <!-- End Tab Contents -->
                    </div>
                </div>
            </div>

            <script>
                <!-- Tab functionality -->
                document.querySelectorAll('.tab-button').forEach(button => {
                button.addEventListener('click', () => {
                const target = button.getAttribute('data-target');
                document.querySelectorAll('.tab-content').forEach(content => {
                content.classList.remove('active');
                });
                document.getElementById(target).classList.add('active');
                });
                });

                <!-- CNIC and Phone Input Mask -->
                $(document).ready(function(){
                <!-- CNIC number format: 99999-9999999-9 -->
                $("#par_cnic_search").inputmask("99999-9999999-9");
                $("#par_cnic").inputmask("99999-9999999-9");

                <!-- Phone number format: 9999-9999999 -->
                $("#par_phone").inputmask("9999-9999999");
                });

                <!-- Flatpickr for Date of Birth -->
                flatpickr("#stu_dob", {
                dateFormat: "d/m/Y",
                allowInput: true
                });
            </script>

        </t>
    </template>
</odoo>
