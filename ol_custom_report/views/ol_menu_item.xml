<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="aging_invoice_form" model="ir.ui.view">
        <field name="name">custom.contact.report</field>
        <field name="model">custom.contact.report</field>
        <field name="arch" type="xml">
            <form string="Student Report">
            <group>
                <group>
                    <field name='start_date' string="Start Date:"/>
                    <field name='end_date' string="End Date:"/>
                </group>
                <group>
                </group>
            </group>
                <footer>
                    <button name="print_xlsx" string="Download Excel Report" type="object" class="btn-primary" />
                </footer>
            </form>
        </field>
    </record>

    <record id="action_custom_contact_report" model="ir.actions.act_window">
        <field name="name">Student Report</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">custom.contact.report</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="help" type="html">
        <p class="o_view_nocontent_smiling_face">
            Create your Report
        </p>
        </field>
    </record>
    <record id="view_sale_book_day_excel" model="ir.ui.view">
        <field name="name">view.sale.book.day.excel </field>
        <field name="model">sale.day.book.report.excel</field>
        <field name="arch" type="xml">
        <form string="Generate Excel File">
            <group>
                <field name="file_name" invisible="1" />
                <field name="excel_file" readonly="1" filename="file_name" />
            </group>
            <footer>
                <button string="Cancel" class="oe_link" special="cancel" />
            </footer>
        </form>
        </field>
    </record>
    <menuitem id="menu_custom_contact_report" 
            name="Student Report" 
            action="action_custom_contact_report" 
            parent="son_accounting_menu.billing_reports_menu" sequence="5" />

</odoo>