<?xml version='1.0' encoding='UTF-8'?>
<odoo>
  <record id="sale_subscription.sale_subscription_action" model="ir.actions.act_window" context="{'studio': True}">
    <field name="binding_model_id" eval="False"/>
    <field name="binding_type">action</field>
    <field name="binding_view_types">list,form</field>
    <field name="context">{
            "search_default_my_subscriptions":1,
            "search_default_group_by_grade_section_display": 1
        }</field>
    <field name="domain">[]</field>
    <field name="filter" eval="False"/>
    <field name="groups_id" eval="[(6, 0, [])]"/>
    <field name="help"><![CDATA[<p class="o_view_nocontent_smiling_face">
                Create a new subscription
            </p><p>
                Create subscriptions to manage recurring invoicing and payments. Subscriptions can
                be time-bounded or not. In case of a limited period, they are flagged as to be renewed
                one month from the end date.
            </p><p>
                Subscriptions can be automatically generated from sales orders in Sales or eCommerce
                apps. To do so, set a subscription template on your subscription products.
            </p>
        ]]></field>
    <field name="limit">80</field>
    <field name="name">Student Fee Plans</field>
    <field name="res_model">sale.subscription</field>
    <field name="search_view_id" eval="False"/>
    <field name="target">current</field>
    <field name="type">ir.actions.act_window</field>
    <field name="usage" eval="False"/>
    <field name="view_id" eval="False"/>
    <field name="view_mode">tree,form,kanban,pivot,graph,cohort,activity</field>
  </record>
  <record id="sale_subscription.sale_subscription_template_action" model="ir.actions.act_window" context="{'studio': True}">
    <field name="binding_model_id" eval="False"/>
    <field name="binding_type">action</field>
    <field name="binding_view_types">list,form</field>
    <field name="context">{}</field>
    <field name="domain" eval="False"/>
    <field name="filter" eval="False"/>
    <field name="groups_id" eval="[(6, 0, [])]"/>
    <field name="help"><![CDATA[<p class="o_view_nocontent_smiling_face">
                Create a new template of subscription
            </p><p>
                Templates are used to prefigure subscription that
                can be selected by the salespeople to quickly configure the
                terms and conditions of the subscription.
            </p>
        ]]></field>
    <field name="limit">80</field>
    <field name="name">Fee Templates</field>
    <field name="res_model">sale.subscription.template</field>
    <field name="search_view_id" eval="False"/>
    <field name="target">current</field>
    <field name="type">ir.actions.act_window</field>
    <field name="usage" eval="False"/>
    <field name="view_id" eval="False"/>
    <field name="view_mode">tree,form,kanban</field>
  </record>
</odoo>
