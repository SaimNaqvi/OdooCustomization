<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="inherit_account_move_tree_view" model="ir.ui.view">
        <field name="name">inherit.account.move.tree.view</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_out_invoice_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//tree[1]/field[@name='invoice_partner_display_name'][2]" position="replace"/>
            <xpath expr="//tree[1]/field[@name='invoice_partner_display_name']" position="replace"/>
            <xpath expr="//field[@name='invoice_date_due']" position="after">
                <field name="due_date_II" invisible="1"/>
                <field name="ol_payment_date_compute" optional="show"/>
            </xpath>
            <xpath expr="//field[@name='invoice_date_due']" position="replace">
                <field name="invoice_date_due" widget="date"/>
            </xpath>
            <xpath expr="//field[@name='invoice_date']" position="attributes">
                <attribute name="optional">hide</attribute>
            </xpath>
        </field>
    </record>
</odoo>