<?xml version='1.0' encoding='UTF-8'?>
<odoo>
    <record id="account_move_form_view_inherited" model="ir.ui.view">
        <field name="name">account.move.form.inherit</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form[1]/sheet[1]/group[1]/group[1]/div[1]" position="before">
                <field name="student_code" string="Student Code"/>
            </xpath>
            <xpath expr="//form[1]/sheet[1]/group[1]/group[1]/div[1]/label[1]" position="attributes">
                <attribute name="string">Student</attribute>
            </xpath>
            <xpath expr="//form[1]/sheet[1]/group[1]/group[1]/field[@name='partner_id']" position="after">
                <field name="invoice_origin"/>
            </xpath>
            <xpath expr="//field[@name='payment_reference']" position="after">
                <field name="x_studio_grade" string="Class"/>
                <field name="x_studio_enrollment_state" string="Enrollment state"/>
                <field name="fee_months" string="Fee Months" widget="many2many_tags"/>
                <!--<field name="ol_payment_date_compute"/>-->
                <field name="x_studio_outstanding" string="outstanding" attrs="{}" invisible="1"/>
            </xpath>
            <!--            <xpath expr="//field[@name='total_arears']" position="attributes">-->
            <!--                <attribute name="attrs">{"invisible": [["payment_state","not in",["not_paid","partial"]],["state","!=","posted"]]}-->
            <!--                </attribute>-->
            <!--            </xpath>-->
            <xpath expr="//form[1]/sheet[1]/notebook[1]/page[@name='other_info']/group[1]/group[@name='sale_info_group']/field[@name='partner_bank_id']"
                   position="after">
                <field name="registered_payments"/>
            </xpath>

            <xpath expr="//field[@name='invoice_line_ids']/tree/field[@name='quantity']" position="attributes">
                <attribute name="string">Months</attribute>
            </xpath>

            <xpath expr="//field[@name='invoice_line_ids']/tree/field[@name='product_uom_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']/tree/field[@name='tax_ids']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//header" position="inside">
                <button name="action_save_and_confirm" type="object" string="Save and Confirm" class="btn-primary"
                        attrs="{'invisible': [('state', '!=', 'draft')]}"/>
            </xpath>
        </field>
    </record>
</odoo>