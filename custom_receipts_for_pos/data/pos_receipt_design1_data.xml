<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Examples for receipt design: which can be used or modified -->
    <record id="pos_receipt_design1" model="pos.receipt">
        <field name="name">Design 1</field>
        <field name="design_receipt"><![CDATA[
                <div class="pos-receipt">
            <!-- Custom header for the POS receipt -->
            <div class="pos-receipt-header" style="text-align: center; font-size: 12px; margin-bottom: 10px;">
                <strong>VAT Sales Receipt</strong><br/>
                <strong>KRUGER PLASTICS LTD</strong><br/>
                P.O. Box SS-5761, Nassau, The Bahamas<br/>
                TIN: 100040726
            </div>

            <!-- Container for logo with text on left and right -->
            <div style="display: flex; align-items: flex-start; justify-content: space-between; font-size: 12px; margin-top: 10px;">

                <!-- Left side information with order date and salesperson -->
                <div style="text-align: left; width: 40%;">
                    <div>#47 Golden Gates</div>
                    <div>Shopping Centre</div>
                    <div>Phone: <t t-esc="env.services.pos.company.phone" /></div>
                    <div style="font-weight: bold;">
                        Date: <t t-esc="props.receipt.date.split(' ')[0]" />
                    </div>
                    <div style="font-weight: bold;">
                        Sale Agent: <t t-esc="env.services.user.name" />
                    </div>
                </div>

                <!-- Center logo, resized to 40px with extra top margin -->
                <div style="text-align: center; width: 20%;">
                    <t t-if="env.services.pos.config.logo">
                        <img t-att-src="'data:image/png;base64,' + env.services.pos.config.logo"
                             alt="Logo" class="pos-receipt-logo"
                             style="width: 40px; height: 40px; margin-bottom: 50px;"/>
                    </t>
                </div>

                <!-- Right side information with customer name -->
                <div style="text-align: right; width: 40%;">
                    <div>
                        Claridge Rd.<br/>
                        at Peardale Manor
                    </div>
                    <div>Phone: <t t-esc="env.services.pos.company.phone" /></div>
                    <div style="font-weight: bold;">
                        Order#:
                        <span style="font-size: smaller; font-weight: normal;">
                            <t t-esc="props.receipt.numeric_name" />
                        </span>
<!--                        <span><t t-esc="props.receipt.name.split('-')[0]" /></span>-->
                    </div>
                    <t t-if="props.receipt.partner and props.receipt.partner.name">
                        <div style="font-weight: bold; font-size: smaller; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                            Customer: <span style="font-size: inherit;"><t t-esc="props.receipt.partner.name[0]" /></span>
                        </div>
                    </t>
                </div>
            </div>
            <div>
                <span style="font-weight: bold;">Location Group:</span>
                <t t-esc="props.receipt.operation_type" />
            </div>
            <t t-if="props.receipt.headerData.header">
                <div style='text-align:center; font-size:13px'>
                    <t t-esc="props.receipt.headerData.header" />
                </div>
                <br />
            </t>
            <div>
                <table class='receipt-orderlines' style="font-size:15px; border-style:double; border-left:none; border-right:none; border-bottom:none; width:100%;">
                    <colgroup>
                        <col width='50%' /> <!-- Product column takes more space -->
                        <col width='10%' />
                        <col width='20%' />
                        <col width='20%' />
                    </colgroup>
                    <tr style="border-bottom:1px dashed black;">
                        <th style="text-align:left;">Item</th>
                        <th style="text-align:center;">Qty</th>
                        <th style="text-align:right;">Price</th>
                        <th style="text-align:right;">Amount</th>
                    </tr>

                    <!-- Check for orderlines -->
                    <t t-if="props.order and props.order.length and props.order[0] and props.order[0].pos and props.order[0].pos.mainScreen and props.order[0].pos.mainScreen.props and props.order[0].pos.mainScreen.props.order and props.order[0].pos.mainScreen.props.order.orderlines and props.order[0].pos.mainScreen.props.order.orderlines.length">
                        <t t-if="props.order[0].pos.mainScreen.props">
                            <tr t-foreach="props.order[0].pos.mainScreen.props.order.orderlines" t-as="orderline" t-key="index_orderlines">
                                <!-- Product Column: Display product code and name -->
                                <td style="padding-top:1%; padding-bottom:1%; text-align:left;">
                                    <t t-esc="orderline.get_product().default_code" /> - <t t-esc="orderline.get_product().display_name" />
                                </td>

                                <!-- Quantity Column: Show only the numeric quantity -->
                                <td style="text-align:center; font-size:14px;">
                                    <t t-esc="orderline.get_quantity()" />
                                </td>

                                <!-- Price Column: Display original price -->
                                <td style="text-align:right; font-size:14px;">
                                    <t t-esc="env.utils.formatCurrency(orderline.get_unit_price())" />
                                </td>

                                <!-- Amount Column: Display total for each line -->
                                <td style="text-align:right; font-size:14px;">
                                    <t t-esc="env.utils.formatCurrency(orderline.get_display_price())"/>
                                </td>
                            </tr>
                        </t>
                    </t>

                    <t t-else="">
                        <t t-if="props.orderlines and props.orderlines.length">
                            <tr t-foreach="props.orderlines" t-as="orderline" t-key="orderline.id">
                                <!-- Product Column -->
                                <td style="padding-top:1%; padding-bottom:1%; text-align:left;">
                                    <t t-esc="orderline.get_product().default_code" /> - <t t-esc="orderline.get_product().display_name" />
                                </td>

                                <!-- Quantity Column -->
                                <td style="text-align:center; font-size:14px;">
                                    <t t-esc="orderline.get_quantity()" />
                                </td>

                                <!-- Price Column -->
                                <td style="text-align:right; font-size:14px;">
                                    <t t-esc="env.utils.formatCurrency(orderline.get_unit_price())" />
                                </td>

                                <!-- Amount Column -->
                                <td style="text-align:right; font-size:14px;">
                                    <t t-esc="env.utils.formatCurrency(orderline.get_display_price())"/>
                                </td>
                            </tr>
                        </t>
                    </t>
                </table>
            </div>
            <br />
            <hr/>
            <div style="padding-top:6px;">
                <table style="width: 100%; font-size: 14px; font-weight: bold; margin-top: 10px; border-collapse: collapse;">
                    <!-- Subtotal -->
                    <tr>
                        <td style="text-align: right; width: 50%; padding: 5px;">Subtotal:</td>
                        <td style="text-align: right; width: 50%; padding: 5px;">
                            <span t-esc='env.utils.formatCurrency(props.data.total_without_tax)' />
                        </td>
                    </tr>

                    <!-- VAT -->
                    <t t-log='props'/>
                    <t t-foreach='props.data.tax_details' t-as='tax' t-key="index_tax_details">
                        <tr>
                            <td style="text-align: right; width: 50%; padding: 5px;">VAT (<t t-esc='tax.name' />):</td>
                            <td style="text-align: right; width: 50%; padding: 5px;">
                                <span t-esc='env.utils.formatCurrency(tax.amount)' />
                            </td>
                        </tr>
                    </t>

                    <!-- Total -->
                    <tr style="border-top: 1px dashed;">
                        <td style="text-align: right; width: 50%; padding: 5px;">TOTAL:</td>
                        <td style="text-align: right; width: 50%; padding: 5px;">
                            <span t-esc='props.order[0].env.utils.formatCurrency(props.data.amount_total)' />
                        </td>
                    </tr>

                    <!-- Payment Lines -->
                    <t t-foreach="props.data.paymentlines" t-as="line" t-key="line_index">
                        <tr>
                            <td style="text-align: right; width: 50%; padding: 5px;">Paid:</td>
                            <td style="text-align: right; width: 50%; padding: 5px;">
                                $ <span t-esc="props.order[0].env.utils.formatCurrency(line.amount, false)" />
                            </td>
                        </tr>
                    </t>
                    <!-- Discounts -->
                    <tr>
                        <t t-if='props.receipt.total_discount'>
                            <td style="text-align: right; width: 50%; padding: 5px;">Discounts: </td>
                            <td style="text-align: right; width: 50%; padding: 5px;">
                                <span t-esc='props.order[0].env.utils.formatCurrency(props.receipt.total_discount)' class="pos-receipt-right-align"/>
                             </td>
                        </t>
                    </tr>
                    <!-- Change -->
                    <tr>
                        <td style="text-align: right; width: 50%; padding: 5px;">Change:</td>
                        <td style="text-align: right; width: 50%; padding: 5px;">
                            <span t-esc="props.order[0].env.utils.formatCurrency(props.data.change)" />
                        </td>
                    </tr>
                </table>

                <t t-if="props.receipt.loyalty_points_won or props.receipt.loyalty_points_spent">
                    <!-- Loyalty Program Heading -->
                    <div style="text-align: left; font-weight: bold; font-size: 16px; margin-top: 10px;">
                        Loyalty Program
                    </div>
                    <div style="font-weight: bold; font-size: 14px; margin-top: 10px;">
                        <span>Points Earned:</span>
                        <span style="float: right;">+<t t-esc="props.receipt.loyalty_points_won" /></span>
                    </div>
<!--                    <div style="font-weight: bold; font-size: 14px; mar gin-top: 5px;">-->
<!--                        <span>Points Spent:</span>-->
<!--                        <span style="float: right;">-<t t-esc="props.receipt.loyalty_points_spent" /></span>-->
<!--                    </div>-->
                    <div style="font-weight: bold; font-size: 14px; margin-top: 5px;">
                        <span>Total Points:</span>
                        <span style="float: right;"><t t-esc="props.receipt.loyalty_points_total" /></span>
                    </div>
                </t>
            </div>

            <div class='before-footer' />
            <br/><br/>
            <!-- Section for Return and Refund Policy at the end of the receipt -->
            <div style="font-size: 10px; margin-top: 20px; text-align: center; line-height: 1.4;">
                <div>Unopened goods may be returned and refunded within 5 working days and must be accompanied by purchase receipt.</div>
                <div>Returned goods are subject to 15% restocking fee.</div>
                <div>Returned checks are subject to $30.00 fee in addition to bank charges.</div>
            </div>
        </div>]]></field>
    </record>

</odoo>