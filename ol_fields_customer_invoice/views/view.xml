<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_account_move_form_inherit" model="ir.ui.view">
            <field name="name">view.account.move.form.inherit</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="arch" type="xml">

                <xpath expr="//form[1]/sheet[1]/notebook[1]/page[1]/group[1]/group[1]/field[@name='narration']" position="after">
                    <field name="total_arears" attrs="{'invisible': [('payment_state', 'not in', ['not_paid','partial']),('state','!=','posted')]}"/>
                    <field name="total_including_arears" attrs="{'invisible': [('payment_state', 'not in', ['not_paid','partial']),('state','!=','posted')]}"/>
                </xpath>
            </field>
        </record>


        <record id="view_account_payment_register_wizard_inherit" model="ir.ui.view">
            <field name="name">view.account.payment.register.wizard.inherit</field>
            <field name="model">account.payment.register</field>
            <field name="inherit_id" ref="account.view_account_payment_register_form"/>
            <field name="arch" type="xml">

                <xpath expr="//field[@name='payment_date']" position="before">
                    <field name="include_arears"/>
                    <field name="total_arears" attrs="{'invisible': [('include_arears', '=', False)]}"/>
                    <field name="total_including_arears" attrs="{'invisible': [('include_arears', '=', False)]}"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
