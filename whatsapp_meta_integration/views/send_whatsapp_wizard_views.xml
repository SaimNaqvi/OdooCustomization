<odoo>
    <record id="view_send_whatsapp_wizard" model="ir.ui.view">
        <field name="name">send.whatsapp.wizard.form</field>
        <field name="model">whatsapp.send.wizard</field>
        <field name="arch" type="xml">
            <form string="Send WhatsApp Message">
                <group>
                    <field name="partner_id" readonly="1"/>
                    <field name="mobile" readonly="1"/>
                </group>
                <group>
                    <field name="message"/>
                </group>
                <footer>
                    <button string="Send" type="object" name="action_send" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
