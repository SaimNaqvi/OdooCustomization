<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_get_person_family" model="ir.actions.act_window">
        <field name="name">Person Family</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">person.family</field>
        <field name="view_mode">kanban,tree,form,activity</field>
        <!--        <field name="search_view_id" ref="base.view_res_partner_filter"/>-->
        <field name="context"></field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a Student Realtion in your address book
            </p>
        </field>
    </record>
    <record id="view_person_family_tree" model="ir.ui.view">
        <field name="name">person.family.tree</field>
        <field name="model">person.family</field>
        <field name="arch" type="xml">
            <tree>
                <field name="person_id" string="Person ID"/>
                <field name="family_id" string="Family ID"/>
                <field name="parent" string="Parent"/>
                <field name="student" string="Student"/>

                <!-- Add other fields here -->
            </tree>
        </field>
    </record>
<!--    <menuitem id="menu_get_person_family"-->
<!--              name="Person Family"-->
<!--              parent="contacts.menu_contacts"-->
<!--              action="action_get_person_family"/>-->
<!--              sequence="1"-->
    <record id="action_student_relation_view_tree" model="ir.actions.act_window.view">
        <field name="sequence" eval="1"/>
        <field name="view_mode">tree</field>
        <field name="view_id" ref="view_person_family_tree"/>
        <field name="act_window_id" ref="action_get_person_family"/>
    </record>
</odoo>
