<odoo>
    <data>
        <!-- Inherit and rename the existing menu item to 'Student Manager' -->
        <record id="contacts.menu_contacts" model="ir.ui.menu">
            <field name="name">Student Manager</field>
        </record>
        <!-- Inherit contacts action window -->
        <record id="contacts.action_contacts" model="ir.actions.act_window">
            <field name="name">Contacts</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">res.partner</field>
            <field name="view_mode">tree,form,kanban,activity</field>
            <field name="search_view_id" ref="base.view_res_partner_filter"/>
            <field name="context">{'default_is_parent': True, 'is_parent_view': True, 'act_window_id':
                'contacts.action_contacts'}
            </field>
            <field name="domain">[('is_parent', '=', True)]</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create a Contact in your address book
                </p>
                <p>
                    Odoo helps you track all activities related to your contacts.
                </p>
            </field>
        </record>


        <record id="view_res_partner_student_filter" model="ir.ui.view">
            <field name="name">res.partner.student.filter</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="base.view_res_partner_filter"/>
            <field name="arch" type="xml">
                <xpath expr="//search" position="inside">
                    <field name="full_name" string="Full Name"/>
                    <!-- Add filters conditionally based on the context -->
                    <filter string="Enrolled" name="Enrolled" domain="[('current_enroll_status', '=', 'Enrolled')]"/>
                    <filter string="Graduate" name="Graduate" domain="[('current_enroll_status', '=', 'Graduate')]"/>
                    <filter string="Admission" name="admission"
                            domain="[('current_enroll_status', '=', 'Admissions')]"/>
                    <filter string="Active" name="active" domain="[('current_enroll_status', '=', 'Active')]"/>
                    <filter string="In Active" name="in_active" domain="[('current_enroll_status', '=', 'In Active')]"/>
                    <filter string="Withdrawn" name="withdrawn" domain="[('current_enroll_status', '=', 'Withdrawn')]"/>
                    <filter string="Grade and Section" name="grade_and_section"
                            domain="[('current_enroll_status', '=', 'Withdrawn')]"/>
                    <!-- Add group by options conditionally based on the context -->
                    <group expand="0" string="Group By">
                        <filter string="Grade and Section" name="group_by_grade_section_display"
                                context="{'group_by':'grade_section_display'}"/>
                        <filter string="Group By Status" name="group_by_status"
                                context="{'group_by': 'current_enroll_status'}"/>
                        <filter string="Group By Grade" name="group_by_grade"
                                context="{'group_by': 'current_grade_selection'}"/>
                    </group>
                </xpath>
            </field>
        </record>

        <!-- Stundets action window -->
        <record id="action_students" model="ir.actions.act_window">
            <field name="name">Students</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">res.partner</field>
            <field name="view_mode">tree,kanban,form,activity</field>
            <field name="search_view_id" ref="student_manager.view_res_partner_student_filter"/>
            <field name="context">{'default_is_student': True, 'is_student_view': True,
                'search_default_group_by_grade_section_display': 1, 'search_default_group_by_status': 1}
            </field>
            <field name="domain">[('is_student', '=', True)]</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create a Student in your address book
                </p>
                <p>
                    Odoo helps you track all activities related to your students.
                </p>
            </field>
        </record>

        <!-- Inherit res.partner searchfilter -->
        <record id="inherit_res_partner_search" model="ir.ui.view">
            <field name="name">inherit.res.partner.search</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="base.view_res_partner_filter"/>
            <field name="arch" type="xml">
                <xpath expr="//search[1]/field[@name='name']" position="after">
                    <field name="facts_id" string="Facts ID"/>
                    <field name="x_studio_parent_id"/>
                    <field name="current_grade"/>
                    <field name="grade_section_display"/>
                </xpath>
                <xpath expr="//field[@name='parent_id']" position="attributes">
                    <attribute name="string">Parent name</attribute>
                </xpath>
                <xpath expr="//filter[@name='type_company']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                <xpath expr="//filter[@name='type_person']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                <xpath expr="//filter[@name='group_company']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                <xpath expr="//filter[@name='group_country']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                <xpath expr="//filter[@name='salesperson']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
            </field>
        </record>


        <!-- Add a new menu item 'Families' and 'Student' under 'Student Manager' -->
        <menuitem id="menu_students"
