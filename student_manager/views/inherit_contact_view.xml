        <record model="ir.actions.server" id="action_sync_records">
            <field name="name">Update Records</field>
            <field name="model_id" ref="model_res_partner"/>
            <field name="binding_model_id" ref="model_res_partner"/>
            <field name="state">code</field>
            <field name="code">
                if records:
                # Extract the list of external student IDs from the selected records
                student_ids = records.mapped('facts_id')

                # Call the method to update multiple records
                records.update_student_record(student_ids)
            </field>
        </record>

        <record model="ir.actions.server" id="action_sync_parent_records">
