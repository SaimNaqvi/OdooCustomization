    <!--            <td>VAT</td>-->
    <!--        </xpath>-->
    <!--    </template>-->


    <template id="external_layout_boxed_custom" inherit_id="web.external_layout_boxed">
        <!-- Try a more specific xpath -->
        <xpath expr="//div[@class='text-center']" position="replace">
            <t t-if="report_type == 'pdf'" style="float:left;">
                <t t-if="o.create_date">
                    <span t-esc="o.create_date.strftime('%B %d, %Y')"/>
                </t>
            </t>
            <div t-if="report_type == 'pdf'" style="float:right;">
                Page:
                <span class="page"/>
                /
                <span class="topage"/>
            </div>
        </xpath>
    </template>

    <template id="report_purchaseorder_document_custom" inherit_id="web.external_layout_boxed">
        <!-- Customize the header -->
        <xpath expr="//div[@class='o_boxed_header']" position="replace">
            <!-- Add "VAT Invoice" just after company info block -->
            <xpath expr="//div[@class='col-12 text-center'][span[@t-field='company.vat']]" position="after">
                <t t-if="o._name == 'account.move' and o.move_type == 'out_invoice'">
                    <div class="row mb-2">
                        <div class="col-12 text-center">
                            <h4 style="text-transform: uppercase;  margin-top: 10px;">
                                VAT Invoice
                            </h4>
                        </div>
                    </div>
                </t>
            </xpath>
            <!-- Company Name and Details -->
            <div class="row mb-2">
                <div class="col-12 text-center">
                    <strong t-field="company.name"/> <!-- Company Name -->
                    <br/>
                    <strong>Email:
                        <span t-field="company.email"/>
                    </strong>
                    <strong style="margin-left:10px;">Website:
                        <span t-field="company.website"/>
                    </strong>
                </div>
            </div>


            <!-- Logo Section -->
            <div class="row mb-2">
                <div class="col-12 text-center mt-0">
                    <img t-if="company.logo" t-att-src="image_data_uri(company.logo)" alt="Logo"
                         style="max-height: 120px;"/>
                </div>
            </div>

            <!-- Address Information -->
            <div class="row mb-2">
                <div class="col-6 text-start" style="margin-top:-80px">
                    <strong>#47 Golden Gates Shopping Centre</strong>
                    <br/>
                    Phone:
                    <span>242 341-4813</span>
                    <br/>
                </div>
                <div class="col-6 text-end" style="margin-top:-80px">
                    <strong>Claridge Rd at Peardale Manor</strong>
                    <br/>
                    Phone:
                    <span>242 393-3626</span>
                    <br/>
                </div>
            </div>
        </xpath>
    </template>


</odoo>
