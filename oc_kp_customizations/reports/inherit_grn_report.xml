<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_picking_inherit" inherit_id="stock.report_picking">
        <xpath expr="//span[strong[contains(text(),'Warehouse Address:')]]" position="before">
            <div>
                <h3>Receiver</h3>
            </div>
        </xpath>
        <xpath expr="//span[strong[contains(text(),'Vendor Address:')]]" position="before">
            <div>
                <h3>Sender</h3>
            </div>
        </xpath>
        <!-- Locate and replace the specific table -->
        <xpath expr="//table[@class='table table-sm']" position="replace">
            <table class="table table-sm" t-if="o.move_line_ids and o.move_ids_without_package">
                <t t-set="has_barcode"
                   t-value="any(move_line.product_id and move_line.product_id.sudo().barcode or move_line.package_id for move_line in o.move_line_ids)"/>
                <t t-set="has_serial_number"
                   t-value="any(move_line.lot_id or move_line.lot_name for move_line in o.move_line_ids)"
                   groups="stock.group_production_lot"/>
                <thead>
                    <tr>
                        <!-- New Columns -->
                        <th name="th_serial_number" style="text-transform: none;">
                            <strong>S.No</strong>
                        </th>
                        <th name="th_part_number" style="text-transform: none;">
                            <strong>Part No</strong>
                        </th>
                        <th name="th_product_sku" style="text-transform: none;">
                            <strong>Code</strong>
                        </th>
                        <!-- Existing Columns -->
                        <th name="th_product" style="text-transform: none;">
                            <strong>Product</strong>
                        </th>
                        <th style="text-transform: none;">
                            <strong>Quantity</strong>
                        </th>
                        <th name="th_from" t-if="o.picking_type_id.code != 'incoming'" align="left"
                            groups="stock.group_stock_multi_locations" style="text-transform: none;">
                            <strong>From</strong>
                        </th>
                        <th name="th_to" t-elif="o.picking_type_id.code != 'outgoing'"
                            groups="stock.group_stock_multi_locations" style="text-transform: none;">
                            <strong>To</strong>
                        </th>
<!--                        <th name="th_serial_number" class="text-center" t-if="has_serial_number" style="text-transform: none;">-->
<!--                            <strong>Lot/Serial Number</strong>-->
<!--                        </th>-->
                        <th name="th_barcode" class="text-center" t-if="has_barcode" style="text-transform: none;">
                            <strong>Product Barcode</strong>
                        </th>
                    </tr>
                </thead>
                <tbody>
                    <!-- Initialize the serial number counter -->
                    <t t-set="serial_number" t-value="0"/>
                    <!-- Loop through move lines -->
                    <tr t-foreach="o.move_ids_without_package.sorted(lambda ml: (ml.location_id.complete_name, ml.location_dest_id.complete_name))"
                        t-as="ml">
                        <!-- Increment serial number -->
                        <t t-set="serial_number" t-value="serial_number + 1"/>
                        <!-- Serial Number Column -->
                        <td>
                            <span t-esc="serial_number"/>
                        </td>
                        <!-- Part Number Column -->
                        <td>
                            <span t-field="ml.part_number"/>
                        </td>
                        <!-- Product SKU Column -->
                        <td>
                            <span t-field="ml.product_sku"/>
                        </td>
                        <!-- Product Column -->
                        <td>
                            <span t-field="ml.product_id.display_name"/>
                            <br/>
                            <span t-if="ml.product_id.description_picking" t-field="ml.product_id.description_picking"/>
                        </td>
                        <!-- Quantity Column -->
                        <td>
                            <span t-field="ml.quantity"/>
                            <span t-field="ml.product_uom" groups="uom.group_uom"/>
                        </td>
                        <!-- From/To Columns -->
                        <td t-if="o.picking_type_id.code != 'incoming'" groups="stock.group_stock_multi_locations">
                            <span t-esc="ml.location_id.display_name"/>
                            <t t-if="ml.package_id">
                                <span t-field="ml.package_id"/>
                            </t>
                        </td>
                        <td t-elif="o.picking_type_id.code != 'outgoing'" groups="stock.group_stock_multi_locations">
                            <span t-field="ml.location_dest_id"/>
<!--                            <t t-if="ml.result_package_id">-->
<!--                                <span t-esc="ml.result_package_id"/>-->
<!--                            </t>-->
                        </td>

                        <!-- Barcode Column -->
                        <td class="text-center" t-if="has_barcode">
                            <span t-esc="ml.product_id.barcode"/>
                        </td>
                    </tr>
                </tbody>
            </table>
        </xpath>
    </template>
</odoo>