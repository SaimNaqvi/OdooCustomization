<odoo>

    <record id="view_bulk_add_hoc_charges_wiz_form" model="ir.ui.view">
        <field name="name">sale.add_hoc_charges_wiz.form</field>
        <field name="model">sale.add_hoc_charges_wiz</field>
        <field name="arch" type="xml">
            <form string="Add Hoc Charges">

                <group>
                    <field name="operation" widget="radio"/>
                    <field name="installment_names" required="1" widget="many2many_tags"/>
                    <field name="product_id" required="1"/>
                    <field name="unit_price" required="1"/>

                    <!-- <field name="plan_ids" /> -->

                    <field name="currency_id" required="1"/>
                    <field name="quantity" required="1"/>

                </group>

                <footer>
                    <button string="Apply" name="apply" type="object" class="oe_highlight" data-hotkey="q"/>
                    <button string="Cancel" class="btn btn-secondary" special="cancel" data-hotkey="z"/>
                </footer>
            </form>
        </field>
    </record>


    <record model="ir.actions.server" id="server_action_Add_hoc_charges_wiz">
        <field name="name">Add Hoc Charges</field>
        <field name="type">ir.actions.server</field>
        <field name="model_id" ref="sale_subscription.model_sale_subscription"/>
        <field name="state">code</field>
        <field name="code">
            action = {
            'name': 'Add Hoc Charges',
            'res_model': 'sale.add_hoc_charges_wiz',
            'view_mode': 'form',
            'context': {
            'active_model': 'sale.subscription',
            'active_ids': records.ids,
            },
            'target': 'new',
            'type': 'ir.actions.act_window',
            }
        </field>
    </record>

</odoo>