<odoo>
    <record id="view_adhoc_charge_wizard_form" model="ir.ui.view">
        <field name="name">adhoc.charge.wizard.form</field>
        <field name="model">adhoc.charge.wizard</field>
        <field name="arch" type="xml">
            <form string="Add Ad Hoc Charges">
                <group>
                    <field name="product_id" />
                    <field name="unit_price" />
                    <field name="quantity" />
                </group>
                <footer>
                    <button string="Add Charges" type="object" name="add_charges" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
