<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="account_move_form_view" model="ir.ui.view">
        <field name="name">account.move.form.view</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@id='edi_documents']" position="after">
                <page name="payment_history" string="Payment History">
                    <field name="payment_history_ids">
                        <tree>
                            <field name="month"/>
                            <field name="invoice_date"/>
                            <field name="payment_date"/>
                            <field name="amount"/>
                        </tree>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>