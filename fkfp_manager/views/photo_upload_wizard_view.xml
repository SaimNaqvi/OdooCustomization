<odoo>
    <record id="view_fkfp_photo_upload_wizard_form" model="ir.ui.view">
        <field name="name">fkfp.photo.upload.wizard.form</field>
        <field name="model">fkfp.photo.upload.wizard</field>
        <field name="arch" type="xml">
            <form string="Upload Photo">
                <group>
                    <field name="image" widget="image"/>
                    <field name="description"/>
                </group>
                <footer>
                    <button name="action_save_photo" type="object" class="btn btn-primary" string="Save"/>
                    <button special="cancel" class="btn btn-secondary" string="Cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>