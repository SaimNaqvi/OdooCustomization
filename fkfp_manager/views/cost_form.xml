<odoo>
    <data>
        <!-- Action for Cost -->
        <record id="action_cost_form" model="ir.actions.act_window">
            <field name="name">Cost</field>
            <field name="res_model">fkfp_manager.cost</field>
            <field name="view_mode">form,tree</field>
            <field name="view_id" ref="view_cost_form"/> <!-- Ensure this reference is correct -->
        </record>

        <!-- Form view for Donor -->
        <record id="view_donor_form" model="ir.ui.view">
            <field name="name">fkfp_manager.donor.form</field>
            <field name="model">fkfp_manager.donor</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <field name="name"/>
                            <field name="contact_info"/>
                            <field name="partner_id"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Action for Donor -->
        <record id="action_donor_form" model="ir.actions.act_window">
            <field name="name">Donor</field>
            <field name="res_model">fkfp_manager.donor</field>
            <field name="view_mode">form,tree</field>
            <field name="view_id" ref="view_donor_form"/> <!-- Ensure this reference is correct -->
        </record>
    </data>
</odoo>