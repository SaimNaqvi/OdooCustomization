<odoo>
    <data>
        <!-- Inherit and rename the existing menu item to 'Student Manager' -->
        <record id="contacts.menu_contacts" model="ir.ui.menu">
            <field name="name">FKFP</field>
        </record>

        <record id="contacts.action_contacts" model="ir.actions.act_window">
            <field name="name">Beneficiary</field>
            <field name="context">{'default_is_individual': True}</field>
        </record>

        <record id="view_partner_tree_with_image" model="ir.ui.view">
            <field name="name">res.partner.tree.inherit.image</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="base.view_partner_tree"/>
            <field name="arch" type="xml">

                <xpath expr="//tree/field[@name='display_name']" position="before">
                    <field name="image_128" widget="image" class="oe_avatar" string="Picture"
                           options="{'preview_image': 'image_128'}"/>
                </xpath>
            </field>
        </record>

        <!-- Inherit the partner form view to add new fields -->
        <record id="view_partner_form_inherit" model="ir.ui.view">
            <field name="name">res.partner.form.inherit.custom</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="base.view_partner_form"/>
            <field name="arch" type="xml">
                <xpath expr="//form//sheet" position="before">
                    <header>
                        <button name="action_open_partner_documents" type="object" string="Document"
                                class="btn-primary"/>
                        <button name="action_partner_photo_gallery" type="object" string="Photo Gallery"
                                class="btn-primary"/>
                        <button name="action_print_cv_report"
                                type="object"
                                string="Print Report"
                                class="btn-primary"/>
                        <!--                        <button name="action_open_donor" type="object" string="Donor" class="btn-primary"/>-->
                    </header>
                </xpath>

                <xpath expr="//field[@name='function']" position="before">
                    <field name="user_define_code" string="Beneficiary Code"/>
                    <field name="phone"/>
                    <field name="marital_status"/>
                    <field name="num_school_children"/>
<!--                    <field name="monthly_family_income" string="Monthly Family Income"/>-->
<!--                    <field name="monthly_total_expense" string="Monthly Total Expense"/>-->

                </xpath>
                <xpath expr="//field[@name='vat']" position="before">
                    <field name="beneficiary_id" string="System ID"/>
                    <field name="mobile" widget="phone"/>
                    <field name="cnic" placeholder="XXXXX-XXXXXXX-X" class="cnic_mask"/>
                    <field name="num_of_dependent" string="Number of Dependent"/>
<!--                    <field name="monthly_self_income" string="Monthly Self Income"/>-->
<!--                    <field name="monthly_total_income" string="Monthly Total Income"/>-->


                </xpath>

                <!-- Add after individual name -->
                <xpath expr="//field[@id='individual']" position="after">
                    <field name="father_name" placeholder="e.g. Father/Husband Name"/>
                </xpath>
                <xpath expr="//div[@class='o_address_format']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                <xpath expr="//span[@name='address_name']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>

                <xpath expr="//field[@name='company_type']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>

                <xpath expr="//field[@name='company_type']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                <xpath expr="//field[@name='parent_id']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                <xpath expr="//field[@name='zip']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                <xpath expr="//field[@name='function']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                <xpath expr="//field[@name='website']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                <xpath expr="//field[@name='vat']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                <xpath expr="//field[@name='category_id']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>

                <xpath expr="//page[@name='sales_purchases']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                <!-- Insert after the main group -->
                <xpath expr="//sheet/group" position="after">
                    <group string="Address Info">
                        <group>
                            <field name="street" string="Present Address"/>
                            <field name="full_address" string="Street"/>
                            <field name="tehsil"/>
                            <field name="village" string="Village"/>
                            <field name="province"/>
                            <field name="nationality"/>
                        </group>
                        <group>
                            <field name="street2" string="Permanent Address"/>
                            <field name="uc"/>
                            <field name="district"/>
                            <field name="city"/>
                            <field name="country_id"/>
                        </group>
                    </group>
                </xpath>
                <xpath expr="//notebook/page[@name='contact_addresses']" position="before">
                    <page string="Progress &amp; Cost">
                        <group cols="2">
                            <group>
                                <field name="status_id"/>
                                <field name="start_date"/>
                                <field name="title" required="True"/>
				<field name="company_id" readonly="True"/>
                            </group>
                            <group>
                                <field name="cost_amount"/>
                                <field name="end_date"/>
                                <field name="branch_id"/>
                            </group>
                        </group>
                    </page>
                </xpath>
                <xpath expr="//notebook/page[@name='contact_addresses']" position="attributes">
                    <attribute name="string">Witness Form</attribute>
                </xpath>
                <xpath expr="//notebook/page[@name='internal_notes']" position="before">
                    <page string="Donors">
                        <field name="donor_line_ids">
                            <tree editable="bottom">
                                <field name="donor_id"/>
                                <field name="amount_used"/>
                            </tree>
                        </field>
                    </page>
                </xpath>
            </field>
        </record>


        <record id="view_res_partner_search_inherit_custom" model="ir.ui.view">
            <field name="name">res.partner.search.inherit.custom</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="base.view_res_partner_filter"/>
            <field name="arch" type="xml">
                <xpath expr="//search" position="inside">
                    <field name="beneficiary_id"/>
                    <field name="user_define_code"/>
                    <field name="cnic"/>
                    <field name="uc"/>
                    <field name="tehsil"/>
                    <field name="district"/>
                    <field name="village"/>
                    <field name="city"/>
                </xpath>
            </field>
        </record>

        <record id="view_partner_form_inherit_hide_field" model="ir.ui.view">
            <field name="name">view.partner.form.inherit.hide.field</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="base.view_partner_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='email']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                <xpath expr="//field[@name='title']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
            </field>
        </record>

    </data>
</odoo>