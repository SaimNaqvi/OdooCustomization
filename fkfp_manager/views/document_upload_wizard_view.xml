<odoo>
    <record id="view_fkfp_document_upload_wizard_form" model="ir.ui.view">
        <field name="name">fkfp.document.upload.wizard.form</field>
        <field name="model">fkfp.document.upload.wizard</field>
        <field name="arch" type="xml">
            <form string="Upload Document">
                <group>
                    <field name="file" widget="image"/>
                    <field name="description"/>
                </group>
                <footer>
                    <button name="action_save_document" type="object" string="Save" class="btn btn-primary"/>
                    <button special="cancel" string="Cancel" class="btn btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>