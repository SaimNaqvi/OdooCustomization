<odoo>
    <data>
        <record id="view_inherit_view_company_form_view" model="ir.ui.view">
            <field name="name">view_inherit_view_company_form_view</field>
            <field name="model">res.company</field>
            <field name="inherit_id" ref="base.view_company_form"/>
            <field name="arch" type="xml">

                <xpath expr="//field[@name='currency_id']" position="after">
                    <field name="is_for_project"/>
                </xpath>
                <xpath expr="//field[@name='is_for_project']" position="after">
                    <field name="is_main_company"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>