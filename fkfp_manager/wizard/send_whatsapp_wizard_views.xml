<odoo>
    <data>
        <!-- Wizard Form View -->
        <record id="view_fkfp_whatsapp_message_wizard" model="ir.ui.view">
            <field name="name">fkfp.whatsapp.message.wizard.form</field>
            <field name="model">fkfp.whatsapp.message.wizard</field>
            <field name="arch" type="xml">
                <form string="Send WhatsApp Message">
                    <group>
                        <field name="staff_id" readonly="1"/>
                        <field name="message" placeholder="Type your message here..." widget="text" required="1"/>
                    </group>
                    <group>
                        <field name="attachment_ids" widget="many2many_binary"/>
                    </group>
                    <footer>
                        <button string="Send" type="object" name="action_send_whatsapp" class="btn-primary"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

    </data>
</odoo>
