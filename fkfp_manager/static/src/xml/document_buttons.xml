<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="fkfp_manager.DocumentListView.Buttons" t-inherit="web.ListView.Buttons">
        <xpath expr="//div[hasclass('o_list_buttons')]" position="inside">
            <button type="button" class="btn btn-secondary" t-on-click="openNicFront">NIC Front</button>
            <button type="button" class="btn btn-secondary" t-on-click="openNicBack">NIC Back</button>
            <button type="button" class="btn btn-secondary" t-on-click="openStampPaper">Stamp Paper</button>
            <button type="button" class="btn btn-secondary" t-on-click="openDas">DAS</button>
            <button type="button" class="btn btn-secondary" t-on-click="openOther">Other</button>
        </xpath>
    </t>
</templates>
